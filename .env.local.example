# Supabaseのプロジェクト設定 > API から取得してコピーしてください
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 管理画面ログインの合言葉(自分で好きな文字列に変更してください)
ADMIN_PASSCODE=sameura2026

# 上記2つとは別に、Cookieの署名に使う任意の長いランダム文字列
# 例: ターミナルで `openssl rand -hex 32` を実行して出た文字列を貼り付け
SESSION_SECRET=change-me-to-a-long-random-string
